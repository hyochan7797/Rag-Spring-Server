# ================================
# AI API 키
# ================================
# OpenAI (임베딩용)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini (답변 생성용)
GOOGLE_API_KEY=your-google-api-key-here

# 금융감독원 금융상품 공시 API
# 발급: https://finlife.fss.or.kr/finlife/main/contents.do?menuNo=700029
FSS_API_KEY=

# /admin/refresh 엔드포인트 보호용 내부 키
ADMIN_API_KEY=admin

# ================================
# Qdrant (docker-compose에서 주입되므로 로컬 직접 실행 시에만 사용)
# ================================
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=loan_docs

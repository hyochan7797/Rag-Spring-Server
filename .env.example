MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=finance_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change-this-app-password

ADMIN_API_KEY=change-this-long-random-admin-key

# Local FastAPI tunnel URL for AWS Spring deployment.
FASTAPI_URL=https://your-fastapi-tunnel.example/chat
FASTAPI_ADMIN_URL=https://your-fastapi-tunnel.example/admin/refresh

# Keep disabled until the local FastAPI tunnel is stable.
LOAN_REFRESH_CRON=-
